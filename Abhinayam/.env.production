# Production Deployment Configuration
# Copy this to your deployment environment and fill in the values

PORT=3000
NODE_ENV=production

# REQUIRED: Set this to your Neon PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=""

# Public base URL (where your site is hosted)
PUBLIC_BASE_URL=https://yourdomain.com

# Storage locations (relative to app root)
UPLOAD_DIR=uploads

# IMPORTANT: Generate a secure random string for production
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-long-random-string-here-change-this-in-production

# Initial admin account (will be created on first start if it doesn't exist)
# CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Shop contact details (can be updated from admin panel later)
WHATSAPP_NUMBER=919999999999
UPI_ID=abhinayamsilks@upi
UPI_PAYEE_NAME=Abhinayam Silks
INSTAGRAM_URL=https://www.instagram.com/abhinayamsilks
