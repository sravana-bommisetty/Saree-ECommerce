{
  "name": "abhinayam-silks",
  "version": "1.0.0",
  "private": true,
  "description": "Abhinayam Silks – saree catalogue website with WhatsApp/UPI ordering and an admin panel",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js \"test/**/*.test.js\"",
    "test:postgres": "node --test test/postgres.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.13.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "twilio": "^4.10.0",
    "crypto": "^1.0.1"
  }
}
