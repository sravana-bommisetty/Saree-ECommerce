# Copy to .env and adjust. Never commit the real .env file.
# 
# PostgreSQL is used for BOTH local development AND production
# Set your Neon PostgreSQL connection string:

DATABASE_URL=""

# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Storage locations (relative to the Abhinayam folder)
UPLOAD_DIR=uploads

# Session secret – use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account (created automatically on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Initial shop contact details (editable later from Admin > Settings)
WHATSAPP_NUMBER=919999999999
UPI_ID=abhinayamsilks@upi
UPI_PAYEE_NAME=Abhinayam Silks
INSTAGRAM_URL=https://www.instagram.com/abhinayamsilks

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Twilio WhatsApp Configuration (for automated messages)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

